<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is off everywhere, with no exceptions and no debug overrides.

  The usual pattern is a <debug-overrides> block that trusts user-installed CAs
  so a developer can point Charles or mitmproxy at the app. That is deliberately
  ABSENT here: this app moves gold and rial, and a build that trusts whatever CA
  happens to be installed on the device is exactly the build that ends up on
  somebody's phone. Developers who need to inspect traffic should run the API
  locally over plain HTTP on the emulator loopback (which the dev flavour
  already points at, and which needs its own exception below), or use the
  server's own request logs.

  Certificate PINNING is not configured here either. It is enforced in Dart, by
  `core/network/certificate_pinning.dart`, because the pin set has to be
  swappable per flavour and the failure has to surface as a typed
  `PinningFailure` the UI can explain.
-->
<network-security-config>

    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
      The dev flavour talks to a Laravel server on the host machine over the
      emulator's loopback alias. This is the ONE cleartext exception, it is
      scoped to two addresses that cannot exist in production, and it still
      does not trust user CAs.

      Remove this block entirely for a release build if you want belt and
      braces; `AppConfig.prod()` never points at these hosts.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>

</network-security-config>
