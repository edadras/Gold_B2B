APP_NAME="Gold B2B"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=goldb2b
DB_USERNAME=goldb2b
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_CLIENT=phpredis

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=30

BROADCAST_CONNECTION=log

# Realtime (docs/05-api/03-realtime-webhooks.md part A).
# `log` writes every broadcast to the log channel and needs no socket server.
# Production runs Laravel Reverb: install it with `composer require
# laravel/reverb`, set BROADCAST_CONNECTION=reverb and the three app
# credentials below, then run `php artisan reverb:start`. The credentials are
# also what POST /api/v1/broadcasting/auth signs with, so the app that serves
# the socket and the app that signs must be the same one.
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST=ws.goldb2b.ir
# REVERB_PORT=443
# REVERB_SCHEME=https
FILESYSTEM_DISK=local

BLIND_INDEX_KEY=
LEDGER_HASH_CHAIN=true

MARKET_OPEN_TIME=09:00
MARKET_CLOSE_TIME=17:30
MARKET_PRE_OPEN_TIME=08:45
